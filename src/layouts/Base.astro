---
import '../styles/global.css';
import Mail from '../components/Mail.astro';
import { site, nav, links, cvPdf } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  room?: boolean; // the after-hours side: grey room instead of the blue sheet
}
const { title, description = site.line, room = false } = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : site.name;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={`${site.name}: writing`} href="/rss.xml" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
  </head>
  <body class={room ? 'room' : undefined}>
    <a class="skip" href="#main">skip to content</a>
    <header class="wrap top">
      <a class="name" href="/">{site.name}</a>
      <nav aria-label="main">
        <ul>
          {nav.map((n) => (
            <li><a href={n.href} aria-current={path === n.href || path.startsWith(n.href + '/') ? 'page' : undefined}>{n.label}</a></li>
          ))}
        </ul>
      </nav>
    </header>
    <main id="main" class="wrap">
      <slot />
    </main>
    <footer class="wrap bottom small">
      <p>
        in a hurry?{' '}
        <a href="/projects">projects</a>{' · '}
        <a href={links.paper}>paper</a>{' · '}
        {cvPdf && <><a href={cvPdf}>cv (pdf)</a>{' · '}</>}
        <a href={links.github}>github</a>{' · '}
        <a href={links.linkedin}>linkedin</a>{' · '}
        <Mail />
      </p>
    </footer>
  </body>
</html>

<style>
  .top { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: var(--space-2) var(--space-4); padding-top: var(--space-4); }
  .name { font-weight: var(--weight-title); text-decoration: none; }
  nav ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--space-1) var(--space-3); font-size: var(--small); }
  nav a { text-decoration: none; }
  nav a:hover, nav a[aria-current='page'] { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 5px; }
  .bottom { padding-bottom: var(--space-5); color: var(--dim); }
  :global(.room) .bottom { color: var(--room-dim); }
</style>
