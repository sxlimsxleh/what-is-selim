---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { fmtMonth } from '../../lib/content';

export async function getStaticPaths() {
  return (await getCollection('photography')).map((s) => ({ params: { id: s.id }, props: { s } }));
}
const { s } = Astro.props;
---
<Base title={s.data.title} description={`${s.data.title}: a photo series by Selim Saleh.`} room>
  <p class="small"><a href="/photography">← photographs</a></p>
  <h1>{s.data.title}</h1>
  <p class="meta">{fmtMonth(s.data.date)}{s.data.location && ` · ${s.data.location}`}</p>
  {s.data.images.map((img) => (
    <figure>
      <Image src={img.src} alt={img.alt} widths={[640, 1280]} sizes="(max-width: 640px) 100vw, 38rem" />
      {img.caption && <figcaption class="meta">{img.caption}</figcaption>}
    </figure>
  ))}
</Base>
