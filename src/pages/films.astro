---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
const films = (await getCollection('films')).sort((a, b) => b.data.year - a.data.year);
---
<Base title="films" description="Films written and directed by Selim Saleh." room>
  <p class="small"><a href="/after-hours">← after hours</a></p>
  <h1>films.</h1>
  {films.length === 0 && <p class="placeholder">films i wrote and directed: coming soon.</p>}
  <ul class="list">
    {films.map((f) => (
      <li>
        <Image src={f.data.still.src} alt={f.data.still.alt} widths={[480, 960]} sizes="(max-width: 640px) 100vw, 38rem" />
        <strong>{f.data.title}</strong>
        <span class="meta">{f.data.year} · {f.data.role.join(', ')}{f.data.runtime && ` · ${f.data.runtime}`}</span>
        <span class="meta">{f.data.logline}</span>
        {f.data.video && <a href={f.data.video}>watch ↗</a>}
      </li>
    ))}
  </ul>
</Base>
